# AgroFleet — variáveis do frontend (Vite). Copie para `frontend/.env.local` e ajuste.
# As variáveis VITE_* entram no build (são públicas: nunca coloque segredos aqui).
# Regra geral: variável AUSENTE = usa o padrão abaixo; variável definida VAZIA ("") = desliga a opção.
#
# PRIVACIDADE (LGPD): com mapa-base ligado, o navegador de cada usuário busca estilos e tiles diretamente nos
# servidores configurados (padrão: OpenFreeMap, atrás da Cloudflare, e EOX). Esses servidores recebem o IP e o
# Referer do usuário. Informe isso no aviso de privacidade ou hospede os tiles você mesmo. Sem mapa-base
# (VITE_BASEMAP_DEFAULT=none e as URLs vazias), nenhum servidor externo é contatado.
# Os talhões simulados ficam em local fictício perto de (-16,70; -47,60), em Goiás: a imagem de fundo é só contexto.

# ---------------------------------------------------------------- Mapa (digital, vetorial)
# Estilo MapLibre (JSON). Padrão: OpenFreeMap "liberty" — grátis, sem chave, sem limite de requisições, uso comercial
# permitido, código MIT (https://openfreemap.org, https://openfreemap.org/tos/). Sem SLA: pode sair do ar sem aviso.
# Não use a instância pública para baixar/semear tiles em lote (proibido nos termos). Atribuição automática:
# "OpenFreeMap © OpenMapTiles Data from OpenStreetMap". Alternativas: estilos do VersaTiles ou um servidor próprio.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Variante para o tema escuro. Padrão: OpenFreeMap "dark" (também existem positron, bright e fiord).
# Se VITE_MAP_STYLE_URL for um estilo próprio e esta ficar ausente, o tema escuro usa o mesmo estilo do claro.
VITE_MAP_STYLE_URL_DARK=https://tiles.openfreemap.org/styles/dark

# Raster legado (compatibilidade com versões anteriores). Só é usado como "Mapa" quando VITE_MAP_STYLE_URL não está
# definida (comente a linha acima) ou está vazia. Exemplo apenas para desenvolvimento, com pouco tráfego:
#   VITE_BASEMAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# O servidor de tiles do OSM não tem SLA, pode bloquear apps comerciais e proíbe download em lote/offline
# (https://operations.osmfoundation.org/policies/tiles/). Com ele, a atribuição fica sempre expandida (não recolhe).
# Sem VITE_BASEMAP_ATTRIBUTION, o OSM recebe "© OpenStreetMap contributors" automaticamente.
VITE_BASEMAP_TILES=
VITE_BASEMAP_ATTRIBUTION=

# ---------------------------------------------------------------- Satélite (raster XYZ)
# Padrão: EOxCloudless 2016 (Sentinel-2, 10 m), licença CC BY 4.0 — uso comercial permitido para o ano 2016 no endpoint
# público, com atribuição visível, tráfego razoável e sem revender os tiles (https://cloudless.eox.at/documentation/faq).
# ATENÇÃO: as camadas 2018 em diante são CC BY-NC-SA (não comerciais); não troque o ano sem licença da EOX.
# O endpoint público não tem SLA e aplica limite de uso. A imagem é de 2016: não representa a lavoura atual.
# Ordem {z}/{y}/{x} (linha antes da coluna), como no WMTS da EOX.
VITE_SATELLITE_TILES=https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless_3857/default/g/{z}/{y}/{x}.jpg
# HTML aceito (links). Exportações estáticas (PNG/PDF) do mapa também precisam levar esta atribuição embutida.
VITE_SATELLITE_ATTRIBUTION=<a href="https://cloudless.eox.at" target="_blank" rel="noopener">EOxCloudless 2016</a> by <a href="https://eox.at" target="_blank" rel="noopener">EOX IT Services GmbH</a> (Contains modified Copernicus Sentinel data 2016) · <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">CC BY 4.0</a>
# Zoom máximo real da fonte (acima disso o MapLibre amplia localmente, sem pedir tiles reamostrados) e tamanho do tile.
VITE_SATELLITE_MAXZOOM=14
VITE_SATELLITE_TILESIZE=256
# Rótulo mostrado no mapa quando o satélite está ativo (data e resolução da imagem).
VITE_SATELLITE_LABEL=Sentinel-2 · 2016 · 10 m
# Alternativa com uso comercial compatível (dados CC BY 4.0, mosaico Sentinel-2 S2GM; serviço em fase Alpha, só até z12):
#   VITE_SATELLITE_TILES=https://tiles.versatiles.org/tiles/satellite/{z}/{x}/{y}
#   VITE_SATELLITE_MAXZOOM=12
#   VITE_SATELLITE_TILESIZE=512
#   VITE_SATELLITE_ATTRIBUTION=<a href="https://versatiles.org/sources/" target="_blank" rel="noopener">VersaTiles</a> · Contains modified Copernicus Sentinel data · CC BY 4.0
#   VITE_SATELLITE_LABEL=Sentinel-2 (S2GM) · ano dos dados não informado
# Qualquer outro XYZ funciona, desde que a licença permita o seu uso (verifique os termos do provedor).

# ---------------------------------------------------------------- Padrão
# Mapa-base inicial: map | satellite | none. A escolha do usuário fica salva no navegador (localStorage "agf-basemap").
# "none" = fundo liso na cor do tema (offline). Ele também é usado automaticamente se o estilo não carregar
# (aviso "Mapa-base indisponível"); as camadas da operação continuam funcionando.
VITE_BASEMAP_DEFAULT=map
