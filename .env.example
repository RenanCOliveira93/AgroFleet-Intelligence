# Copie para .env e TROQUE TODOS os valores CHANGE_ME. O compose recusa subir sem as variáveis obrigatórias.
POSTGRES_USER=agrofleet
POSTGRES_PASSWORD=CHANGE_ME_postgres
POSTGRES_DB=agrofleet

# Broker: dois usuários distintos. device = só PUBLICA telemetria; ingest = só LÊ telemetria (ACL em infra/mosquitto).
MQTT_DEVICE_USER=device
MQTT_DEVICE_PASSWORD=CHANGE_ME_device
MQTT_INGEST_USER=ingest
MQTT_INGEST_PASSWORD=CHANGE_ME_ingest
MQTT_PORT_HOST=1883

# API. Segredo do JWT >= 32 caracteres (ex.: openssl rand -base64 48). Usuário sem senha NÃO é criado.
AGROFLEET_AUTH_SECRET=CHANGE_ME_with_at_least_32_random_characters
AGROFLEET_ADMIN_PASSWORD=CHANGE_ME_admin
AGROFLEET_ANALYST_PASSWORD=CHANGE_ME_analyst
AGROFLEET_VIEWER_PASSWORD=CHANGE_ME_viewer
HTTP_PORT=8080

# Simulador (perfil "sim")
SIM_SPEEDUP=20
SIM_SEED=7
SIM_MAX_SECONDS=3600
